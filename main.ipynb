    "    \"pickup\": \"Pickup\", \"lorry\": \"Lorry\", \"paddy cutter vehicles\": \"Paddy cutter vehicles\",\n",
    "    \"bulkhead\": \"Bulkhead\", \"crane\": \"Crane\", \"wrecker\": \"Wrecker\", \"tractor\": \"Tractor\",\n",
    "    \"cart\": \"Cart\", \"leguna\": \"Leguna\", \"nosimon\": \"Nosimon\", \"three-wheeler\": \"Three-Wheeler\",\n",
